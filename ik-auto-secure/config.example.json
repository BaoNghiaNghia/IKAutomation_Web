{
  "target_url": "https://ik.playfun.vn/play-game",
  "data_dir": "data",
  "browser": {
    "chrome_executable": "auto",
    "headless": false,
    "app_mode": true,
    "profile_title": true,
    "low_memory_mode": true,
    "auto_resize": true,
    "viewport": {
      "width": 500,
      "height": 281
    },
    "windows_per_row": 6,
    "slow_mo_ms": 0,
    "startup_timeout_ms": 90000
  },
  "capture": {
    "network_capture_enabled": false,
    "allowed_hosts": [
      "ik.playfun.vn",
      "gtarcade.com",
      "smobgame.com"
    ],
    "max_body_bytes": 131072,
    "max_text_chars": 6000,
    "capture_response_bodies": false,
    "snapshot_retention": 50
  },
  "profiles": [
    {
      "id": "main",
      "name": "Main",
      "mode": "managed",
      "user_data_dir": "data/profiles/main",
      "cdp_url": null,
      "enabled": true
    }
  ]
}
